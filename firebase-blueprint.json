{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "School task, test, homework, or study plan item for student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "subjectCode": { "type": "string", "maxLength": 10 },
        "type": { "type": "string", "enum": ["tpc", "teste", "trabalho", "mochila", "outro"] },
        "description": { "type": "string", "maxLength": 2000 },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dueTime": { "type": "string" },
        "academicYear": { "type": "string", "maxLength": 20 },
        "studyPlanDaysBefore": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "subjectCode", "type", "dueDate", "createdAt"]
    },
    "CheckIn": {
      "title": "CheckIn",
      "description": "Proof of completed homework or study session with photo validation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "timestamp": { "type": "string" },
        "photoDataUrl": { "type": "string" },
        "notes": { "type": "string", "maxLength": 1000 },
        "confirmedBy": { "type": "string", "enum": ["filho", "pais"] }
      },
      "required": ["id", "taskId", "timestamp", "photoDataUrl", "confirmedBy"]
    },
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "Timetable class slot for student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dayOfWeek": { "type": "number" },
        "timeIndex": { "type": "number" },
        "subjectCode": { "type": "string", "maxLength": 10 },
        "room": { "type": "string", "maxLength": 20 },
        "academicYear": { "type": "string", "maxLength": 20 },
        "note": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "dayOfWeek", "timeIndex", "subjectCode", "room"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Parental and app settings",
      "type": "object",
      "properties": {
        "greenDaysThreshold": { "type": "number" },
        "yellowDaysThreshold": { "type": "number" },
        "parentPin": { "type": "string", "maxLength": 10 },
        "studentName": { "type": "string", "maxLength": 100 },
        "favoriteTeam": { "type": "string", "maxLength": 50 },
        "academicYear": { "type": "string", "maxLength": 20 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "studentClass": { "type": "string", "maxLength": 50 },
        "allowedEmails": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["greenDaysThreshold", "yellowDaysThreshold", "parentPin", "studentName"]
    },
    "CheckInAlert": {
      "title": "CheckInAlert",
      "description": "Shared real-time broadcast notification when a check-in is completed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "taskTitle": { "type": "string", "maxLength": 200 },
        "subjectCode": { "type": "string", "maxLength": 10 },
        "taskType": { "type": "string", "enum": ["tpc", "teste", "trabalho", "mochila", "outro"] },
        "message": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "photoDataUrl": { "type": "string" }
      },
      "required": ["id", "taskId", "taskTitle", "subjectCode", "message", "timestamp"]
    },
    "BackpackDay": {
      "title": "BackpackDay",
      "description": "Daily backpack preparation checklist items status",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["dateKey", "items"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Parental audit log tracking system usage and actions per user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["id", "timestamp", "userEmail", "action", "description"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "School tasks collection for 9º B"
    },
    "/checkins/{checkinId}": {
      "schema": "CheckIn",
      "description": "Task check-ins with photo proof"
    },
    "/alerts/{alertId}": {
      "schema": "CheckInAlert",
      "description": "Real-time shared check-in confirmation alerts for family devices"
    },
    "/schedule/{scheduleId}": {
      "schema": "ScheduleItem",
      "description": "Class timetable collection"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "App settings configuration"
    },
    "/backpack/{dateKey}": {
      "schema": "BackpackDay",
      "description": "Backpack checklist status per date"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Activity and usage audit logs per user for parental monitoring"
    }
  }
}
